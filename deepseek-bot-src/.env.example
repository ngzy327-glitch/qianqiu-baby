# ===== SPECTRE · 多智能体红队框架 配置示例(复制为 .env 并填自己的值) =====

# ===== 核心必填 =====
DEEPSEEK_API_KEY=sk-YOUR_API_KEY_HERE
DEEPSEEK_API=https://api.deepseek.com/v1
DEEPSEEK_BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# 必填: Telegram 应用凭据(https://my.telegram.org → API development tools)
TG_API_ID=2040
TG_API_HASH=b18441a1ff607e10a989891a5462e627

# 主人 TG ID(唯一可提权/降权的人, 不填则用代码内默认)
OWNER_ID=8229799375

# ===== 主备用双通道(可选, 主通道故障自动切换) =====
DEEPSEEK_API_KEY_BK=
DEEPSEEK_API_BK=https://api.deepseek.com/v1

# ===== DP 通道(DeepSeek官方通道独立配置, 不填则回退到上面的 DEEPSEEK_*) =====
DP_API=
DP_API_KEY=
DP_MODEL_MAIN=deepseek-flash
DP_MODEL_LIGHT=deepseek-flash
DP_MODEL_PRO=deepseek-v4-pro

# ===== 模型配置 =====
DSB_MODEL_MAIN=deepseek-flash
DSB_MODEL_BETA=deepseek-flash
DSB_MODEL_PRO=deepseek-v4-pro

# ===== 品牌/外观 =====
DSB_BRAND=全能 agent bot
DSB_DEV=your_account
# 富文本开关: 1=开(默认), 0=关(纯文本输出)
DSB_RICH=1

# ===== 功能开关 =====
# 切换备用 bot token(设 1 启用)
USE_ALT_BOT_FLAG=
# 禁用 TG 双号(设 1 禁用)
DSB_NO_TGDUAL=
# 工具调用调试日志(设 1 开启, 排查时用)
TOOL_DEBUG=

# ===== 群聊 =====
# 群聊触发词(逗号分隔, 命中任一即触发回复; 默认"大肥鱼"+品牌名)
GROUP_TRIGGER=大肥鱼
# 额外 bot 用户名(逗号分隔, 群内 @ 这些用户名也触发)
BOT_UNAME_EXTRA=

# ===== 第三方 Key(可选) =====
FOFA_API_KEY=
FOFA_EMAIL=
QWEN_API_KEY=
# 阿里云 DashScope key(QWEN_API_KEY 的回退)
DASHSCOPE_API_KEY=
# Qwen OCR 模型
QWEN_MODEL=qwen3-vl-flash

# ===== Mini App =====
# Mini App 公网地址(nginx 反代后的 HTTPS 域名, 不填则用代码内默认占位)
MINIAPP_PUBLIC_URL=
# Mini App 后端端口(默认 8901)
MINIAPP_PORT=8901

# ===== 路径配置(可选, 不填用默认) =====
# 安装根目录
BOT_BASE=/opt/deepseek-bot
# 白名单文件路径
OK_IDS_FILE=/opt/deepseek-bot/ok_ids.json
# Telegram session 路径
SESSION_PATH=/opt/deepseek-bot/sessions/ds
# Jailguard 状态文件路径
JAILGUARD_STATE=/tmp/jailguard_state.json

# ===== 代理(可选) =====
# 动态代理池 URL(留空=直连; 也可通过 proxy.json 配置)
PROXY_DYNAMIC_URL=
