# Telegram bot token（@BotFather 拿）
TG_BOT_TOKEN=

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 人格/接话
BOT_NICKNAME=林织叶
CHAT_PROBABILITY=0.15
MAX_HISTORY_LENGTH=10
MAX_TOKENS=150
TEMPERATURE=0.9

# /setprob 用，填你自己的 Telegram 数字 ID（@userinfobot 查）；0 = 不开放
ADMIN_ID=0

# 数据目录（记忆/表情包），默认脚本同目录 data/
# DATA_DIR=/opt/tg-chatbot/data
